<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_1.xsd"
             version="3.1">
    <persistence-unit name="tropico-jpa" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <class>org.generation.italy.examples.model.Citizen</class>
        <class>org.generation.italy.examples.model.Faction</class>
        <class>org.generation.italy.examples.model.Building</class>
        <class>org.generation.italy.examples.model.BuildingType</class>
        <class>org.generation.italy.examples.model.Resource</class>
        <class>org.generation.italy.examples.model.ProductionBatch</class>

        <exclude-unlisted-classes>true</exclude-unlisted-classes>
    </persistence-unit>
</persistence>
